# ——————————————————————————————
# retake-ai 本地运行配置（复制为 .env 后填写；.env 已被 .gitignore 忽略）
# 所有 Key 均为「用户自带」（BYO Key），只落本地，代码里任何日志/错误回显都会掩码。
# ——————————————————————————————

# ===== 数据根目录（一个 job 一个 JSON 文件 + 本地素材库都写在这里）=====
# 相对路径相对于工程根；默认 ./data
RETAKE_HOME=./data

# ===== 火山方舟 Ark（Seedance 视频生成）=====
# 开通指引见 README「开通云 Key」一节
ARK_API_KEY=
# 建议直连官方方舟；中转站协议有差异（对未知路径返回 200 + HTML），换站前先探健康端点
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 视频生成模型 ID（在方舟控制台开通后填入，如 doubao-seedance-2-0-xxxxxx）
SEEDANCE_MODEL=
# 可选：分辨率档位（480p/720p/1080p）。留空 = 不传该参数，由模型默认决定。
# 注意：客户端参数白名单通过 ≠ 目标模型支持该取值，请按 SEEDANCE_MODEL 实测。
SEEDANCE_RESOLUTION=
# 可选：prompt 超长压缩用的对话模型（留空则跳过 LLM 压缩，走本地确定性压缩）
ARK_CHAT_MODEL=

# ===== AI MediaKit（OCR / ASR / 烧录 / drama-script 剧本还原 / 拼接）=====
MEDIKIT_API_KEY=
MEDIKIT_BASE_URL=https://mediakit.cn-beijing.volces.com
# 产物直存目的地（tos://桶名/目录）。⚠️ 需在 AI MediaKit 控制台单独授权「跨服务写」权限，
# 否则产物只能拿到带 auth_key 的 VOD 预览链（24h 失效，且不能作为下一步工具的入参）。
MEDIKIT_OUTPUT_DEST=
# tos:// → 公网 https 的端点（不含桶名），如 tos-cn-beijing.volces.com
TOS_PUBLIC_ENDPOINT=
# 可选：MediaKit 队列 ID（一般留空）
MEDIKIT_QUEUE_ID=

# ===== 本地媒体工具（⚠️ 必须填绝对路径，代码不假设 ffmpeg 在 PATH）=====
# 怎么找：先跑 `where.exe ffmpeg`；没装的话装一个带 libx264 的 build（如 gyan.dev essentials），
# 然后把两个 exe 的完整路径填进来。.env 解析按「原样字面量」处理，Windows 路径写单反斜杠。
# 本仓库开发机已验证可用的一处：D:\develop\ffmpeg\ffmpeg.exe（ffmpeg 9.0.2，含 libx264）
FFMPEG_BIN=
FFPROBE_BIN=

# ===== 本地 HTTP 服务 =====
SERVER_PORT=8787
SERVER_HOST=127.0.0.1
